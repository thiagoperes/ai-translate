{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "newLine": "lf",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "paths": {
      "@ai-translate/cli": ["./packages/ai-translate-cli/src/index.ts"],
      "@ai-translate/cli/*": ["./packages/ai-translate-cli/src/*"],
      "@ai-translate/core": ["./packages/ai-translate-core/src/index.ts"],
      "@ai-translate/core/*": ["./packages/ai-translate-core/src/*"],
      "@ai-translate/fs-json": ["./packages/ai-translate-fs-json/src/index.ts"],
      "@ai-translate/fs-json/*": ["./packages/ai-translate-fs-json/src/*"],
      "@ai-translate/html": ["./packages/ai-translate-html/src/index.ts"],
      "@ai-translate/html/*": ["./packages/ai-translate-html/src/*"],
      "@ai-translate/keystatic": ["./packages/ai-translate-keystatic/src/index.ts"],
      "@ai-translate/keystatic/*": ["./packages/ai-translate-keystatic/src/*"],
      "@ai-translate/markdoc": ["./packages/ai-translate-markdoc/src/index.ts"],
      "@ai-translate/markdoc/*": ["./packages/ai-translate-markdoc/src/*"],
      "@ai-translate/message-formats": ["./packages/ai-translate-message-formats/src/index.ts"],
      "@ai-translate/message-formats/*": ["./packages/ai-translate-message-formats/src/*"],
      "@ai-translate/next": ["./packages/ai-translate-next/src/index.ts"],
      "@ai-translate/next/*": ["./packages/ai-translate-next/src/*"],
      "@ai-translate/provider-ai-sdk": ["./packages/ai-translate-provider-ai-sdk/src/index.ts"],
      "@ai-translate/provider-ai-sdk/*": ["./packages/ai-translate-provider-ai-sdk/src/*"],
      "@ai-translate/provider-core": ["./packages/ai-translate-provider-core/src/index.ts"],
      "@ai-translate/provider-core/*": ["./packages/ai-translate-provider-core/src/*"],
      "@ai-translate/provider-openai": ["./packages/ai-translate-provider-openai/src/index.ts"],
      "@ai-translate/provider-openai/*": ["./packages/ai-translate-provider-openai/src/*"]
    },
    "types": ["node"],
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  }
}
