{
  "name": "@ai-translate/provider-ai-sdk",
  "version": "0.1.0",
  "description": "Run ai-translate against any AI SDK provider — OpenAI, Anthropic, Google, Bedrock, or a gateway — with one interchangeable translation and semantic-audit provider.",
  "keywords": [
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "translation",
    "ai",
    "ai-sdk",
    "vercel",
    "llm",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "author": "Thiago Peres",
  "homepage": "https://github.com/thiagoperes/ai-translate#packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagoperes/ai-translate.git",
    "directory": "packages/ai-translate-provider-ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/thiagoperes/ai-translate/issues"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings src test vitest.config.ts tsdown.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "test:pack": "publint . && attw --pack . --profile esm-only",
    "coverage:strict": "vitest run --config vitest.config.ts --coverage --coverage.include=src/index.ts --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=95 --coverage.thresholds.statements=95"
  },
  "dependencies": {
    "@ai-translate/core": "workspace:*",
    "@ai-translate/provider-core": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "ai": "7.0.65"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
