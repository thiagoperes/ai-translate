{
  "name": "@ai-translate/core",
  "version": "0.3.0",
  "description": "Engine for AI translation pipelines: catalog reconciliation, translation state and provenance, deterministic validators, and semantic audits.",
  "keywords": [
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "translation",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "Thiago Peres",
  "homepage": "https://github.com/thiagoperes/ai-translate#packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagoperes/ai-translate.git",
    "directory": "packages/ai-translate-core"
  },
  "bugs": {
    "url": "https://github.com/thiagoperes/ai-translate/issues"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./address": {
      "types": "./dist/address.d.mts",
      "import": "./dist/address.mjs",
      "default": "./dist/address.mjs"
    },
    "./acceptance": {
      "types": "./dist/acceptance.d.mts",
      "import": "./dist/acceptance.mjs",
      "default": "./dist/acceptance.mjs"
    },
    "./audit": {
      "types": "./dist/audit.d.mts",
      "import": "./dist/audit.mjs",
      "default": "./dist/audit.mjs"
    },
    "./constraints": {
      "types": "./dist/constraints.d.mts",
      "import": "./dist/constraints.mjs",
      "default": "./dist/constraints.mjs"
    },
    "./hash": {
      "types": "./dist/hash.d.mts",
      "import": "./dist/hash.mjs",
      "default": "./dist/hash.mjs"
    },
    "./json": {
      "types": "./dist/json.d.mts",
      "import": "./dist/json.mjs",
      "default": "./dist/json.mjs"
    },
    "./message-format": {
      "types": "./dist/message-format.d.mts",
      "import": "./dist/message-format.mjs",
      "default": "./dist/message-format.mjs"
    },
    "./plural": {
      "types": "./dist/plural.d.mts",
      "import": "./dist/plural.mjs",
      "default": "./dist/plural.mjs"
    },
    "./policies": {
      "types": "./dist/policies.d.mts",
      "import": "./dist/policies.mjs",
      "default": "./dist/policies.mjs"
    },
    "./reconcile": {
      "types": "./dist/reconcile.d.mts",
      "import": "./dist/reconcile.mjs",
      "default": "./dist/reconcile.mjs"
    },
    "./sync": {
      "types": "./dist/sync.d.mts",
      "import": "./dist/sync.mjs",
      "default": "./dist/sync.mjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.mts",
      "import": "./dist/tokens.mjs",
      "default": "./dist/tokens.mjs"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.mts",
      "import": "./dist/telemetry.mjs",
      "default": "./dist/telemetry.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs",
      "default": "./dist/types.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings src test vitest.config.ts tsdown.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "coverage:strict": "vitest run --config vitest.config.ts --coverage --coverage.include=src/hash.ts --coverage.include=src/tokens.ts --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=95 --coverage.thresholds.statements=95",
    "test:pack": "publint . && attw --pack . --profile esm-only"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
