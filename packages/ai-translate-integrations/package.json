{
  "name": "@ai-translate/integrations",
  "version": "0.1.0",
  "description": "Composable project detection and configuration generation for ai-translate localization adapters.",
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "translation",
    "codegen"
  ],
  "license": "MIT",
  "author": "Thiago Peres",
  "homepage": "https://github.com/thiagoperes/ai-translate/tree/main/packages/ai-translate-integrations#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagoperes/ai-translate.git",
    "directory": "packages/ai-translate-integrations"
  },
  "bugs": {
    "url": "https://github.com/thiagoperes/ai-translate/issues"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings src test vitest.config.ts tsdown.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "test:pack": "publint . && attw --pack . --profile esm-only"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
