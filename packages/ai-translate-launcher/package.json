{
  "name": "ai-translate",
  "version": "0.1.0",
  "description": "Run ai-translate with npx: native Apple, JSON, and content translation pipelines.",
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "translation",
    "cli",
    "ios",
    "ai"
  ],
  "license": "MIT",
  "author": "Thiago Peres",
  "homepage": "https://github.com/thiagoperes/ai-translate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagoperes/ai-translate.git",
    "directory": "packages/ai-translate-launcher"
  },
  "bugs": {
    "url": "https://github.com/thiagoperes/ai-translate/issues"
  },
  "bin": {
    "ai-translate": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings src test vitest.config.ts tsdown.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "test:pack": "publint . && attw --pack . --profile esm-only && node ../../scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@ai-translate/cli": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
