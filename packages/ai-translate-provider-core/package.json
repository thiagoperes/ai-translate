{
  "name": "@ai-translate/provider-core",
  "version": "0.2.0",
  "description": "Vendor-neutral translation and semantic-audit engine for ai-translate: prompting, batching, structured output, validation and repair over a pluggable model transport.",
  "keywords": [
    "i18n",
    "l10n",
    "internationalization",
    "localization",
    "translation",
    "ai",
    "llm",
    "structured-output"
  ],
  "license": "MIT",
  "author": "Thiago Peres",
  "homepage": "https://github.com/thiagoperes/ai-translate#packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagoperes/ai-translate.git",
    "directory": "packages/ai-translate-provider-core"
  },
  "bugs": {
    "url": "https://github.com/thiagoperes/ai-translate/issues"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings src test vitest.config.ts tsdown.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "coverage:strict": "vitest run --config vitest.config.ts --coverage --coverage.include=src/index.ts --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=85 --coverage.thresholds.statements=95",
    "test:pack": "publint . && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@ai-translate/core": "workspace:*",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
